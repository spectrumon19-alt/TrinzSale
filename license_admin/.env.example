# TrintzPOS License Admin Portal — Environment Variables
# Copy this to .env and fill in your values.

# Strong random secret for Flask sessions
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Admin portal password (plain text for dev; bcrypt hash for production)
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpass', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD=admin

# RSA key paths (private.pem stays on YOUR machine only — never ship to clients)
PRIVATE_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public.pem

# SQLite database for license records
DB_PATH=data/licenses.db

# Port (localhost only — never bind to 0.0.0.0)
PORT=5002

# ── Distribution Builder ────────────────────────────────────────────────────────

# Path to the TrintzPOS source code directory
# This is the default source used when building customer distributions
SOURCE_CODE_DIR=C:\path\to\trintzpos\source

# Base directory where customer distribution folders are saved
# Each build creates: DIST_OUTPUT_BASE\CustomerName_YYYY-MM-DD\
DIST_OUTPUT_BASE=C:\TrintzDist\customers

# ── SMTP Email (for sending distribution packages to customers) ─────────────────

# Gmail example:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Outlook example: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Use an App Password for Gmail (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
