# .env.example - Example environment variables for POS System

# Secret key for JWT token generation
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secure-secret-key-here

# Encryption key for AI provider API keys stored in the database (Fernet).
# Strongly recommended in production so stored sk-ant-… keys are encrypted at rest.
# If omitted, the key is derived from SECRET_KEY (works, but rotating SECRET_KEY
# would then orphan stored AI keys — set a dedicated key to avoid that).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEY_ENCRYPTION_KEY=

# Restrict CORS to your domain in production (e.g. https://pos.yourdomain.com)
# Leave as * only for local development
ALLOWED_ORIGIN=*

# Database configuration (Option 1: Individual variables)
DB_HOST=localhost
DB_NAME=pos_db
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_PORT=5432

# Database configuration (Option 2: Single DATABASE_URL - used as fallback on Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Brevo transactional email (HTTP API — no SMTP needed)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=TrintzERP

# License guard (set to false on Render/cloud; leave true or omit for on-premise .exe)
# LICENSE_GUARD_ENABLED=false
# Google Drive backup via OAuth (the "Connect Google Drive" button on backup.html)
# One-time setup: console.cloud.google.com -> enable Drive API -> OAuth client ID
# (Web application) with redirect URI matching GOOGLE_OAUTH_REDIRECT_URI below.
# Full walkthrough: OAUTH_SETUP_GUIDE.md
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
# Dev default (matches code default). On Render use https://<your-app>.onrender.com/api/backup/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/backup/oauth/callback
